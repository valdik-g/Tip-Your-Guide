<%= render Home::HeroComponent.new(total_places: @places_count, total_users: @total_users, total_payments: @payments_count) %>

<%= render Home::FeaturesComponent.new %>

<section id="business" class="py-12 bg-gray-50 sm:py-16 lg:py-20">
  <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-3xl font-extrabold text-gray-900 sm:text-4xl lg:text-5xl">
        <%= t("home.business_section.title") %>
      </h2>
      <p class="mt-4 text-lg text-gray-600 sm:text-xl">
        <%= t("home.business_section.subtitle") %>
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 mt-12 sm:grid-cols-2 lg:grid-cols-3 sm:gap-12">
      <%# Benefit 1: Easy Onboarding %>
      <div class="overflow-hidden bg-white rounded-lg shadow">
        <div class="p-6">
          <h3 class="text-xl font-semibold text-gray-900"><%= t("home.business_section.benefits.easy_onboarding.title") %></h3>
          <p class="mt-3 text-base text-gray-600"><%= t("home.business_section.benefits.easy_onboarding.text") %></p>
        </div>
      </div>

      <%# Benefit 2: Metrics %>
      <div class="overflow-hidden bg-white rounded-lg shadow">
        <div class="p-6">
          <h3 class="text-xl font-semibold text-gray-900"><%= t("home.business_section.benefits.metrics.title") %></h3>
          <p class="mt-3 text-base text-gray-600"><%= t("home.business_section.benefits.metrics.text") %></p>
        </div>
      </div>

      <%# Benefit 3: Reviews %>
      <div class="overflow-hidden bg-white rounded-lg shadow">
        <div class="p-6">
          <h3 class="text-xl font-semibold text-gray-900"><%= t("home.business_section.benefits.reviews.title") %></h3>
          <p class="mt-3 text-base text-gray-600"><%= t("home.business_section.benefits.reviews.text") %></p>
        </div>
      </div>

      <%# Benefit 4: Branding %>
      <div class="overflow-hidden bg-white rounded-lg shadow">
        <div class="p-6">
          <h3 class="text-xl font-semibold text-gray-900"><%= t("home.business_section.benefits.branding.title") %></h3>
          <p class="mt-3 text-base text-gray-600"><%= t("home.business_section.benefits.branding.text") %></p>
        </div>
      </div>

      <%# Benefit 5: Reports %>
      <div class="overflow-hidden bg-white rounded-lg shadow">
        <div class="p-6">
          <h3 class="text-xl font-semibold text-gray-900"><%= t("home.business_section.benefits.reports.title") %></h3>
          <p class="mt-3 text-base text-gray-600"><%= t("home.business_section.benefits.reports.text") %></p>
        </div>
      </div>

      <%# Benefit 6: Support %>
      <div class="overflow-hidden bg-white rounded-lg shadow">
        <div class="p-6">
          <h3 class="text-xl font-semibold text-gray-900"><%= t("home.business_section.benefits.support.title") %></h3>
          <p class="mt-3 text-base text-gray-600"><%= t("home.business_section.benefits.support.text") %></p>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="solo-guides" class="py-12 bg-white sm:py-16 lg:py-20">
  <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-3xl font-extrabold text-gray-900 sm:text-4xl lg:text-5xl">
        <%= t("home.solo_guides_section.title") %>
      </h2>
      <p class="mt-4 text-lg text-gray-600 sm:text-xl">
        <%= t("home.solo_guides_section.subtitle") %>
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 mt-12 sm:grid-cols-2 lg:grid-cols-3 sm:gap-12">
      <%# Benefit 1: Easy Signup %>
      <div class="overflow-hidden bg-gray-50 rounded-lg shadow">
        <div class="p-6">
          <h3 class="text-xl font-semibold text-gray-900"><%= t("home.solo_guides_section.benefits.easy_signup.title") %></h3>
          <p class="mt-3 text-base text-gray-600"><%= t("home.solo_guides_section.benefits.easy_signup.text") %></p>
        </div>
      </div>

      <%# Benefit 2: Quick Payouts %>
      <div class="overflow-hidden bg-gray-50 rounded-lg shadow">
        <div class="p-6">
          <h3 class="text-xl font-semibold text-gray-900"><%= t("home.solo_guides_section.benefits.quick_payouts.title") %></h3>
          <p class="mt-3 text-base text-gray-600"><%= t("home.solo_guides_section.benefits.quick_payouts.text") %></p>
        </div>
      </div>

      <%# Benefit 3: Zero Fees %>
      <div class="overflow-hidden bg-green-50 border-4 border-green-500 rounded-lg shadow-lg">
        <div class="p-6">
          <h3 class="text-xl font-semibold text-gray-900"><%= raw t("home.solo_guides_section.benefits.zero_fees_html") %></h3>
          <%# No extra text needed as it's in the title %>
        </div>
      </div>

      <%# Benefit 4: Metrics %>
      <div class="overflow-hidden bg-gray-50 rounded-lg shadow">
        <div class="p-6">
          <h3 class="text-xl font-semibold text-gray-900"><%= t("home.solo_guides_section.benefits.metrics.title") %></h3>
          <p class="mt-3 text-base text-gray-600"><%= t("home.solo_guides_section.benefits.metrics.text") %></p>
        </div>
      </div>

      <%# Benefit 5: Content Control %>
      <div class="overflow-hidden bg-gray-50 rounded-lg shadow">
        <div class="p-6">
          <h3 class="text-xl font-semibold text-gray-900"><%= t("home.solo_guides_section.benefits.content_control.title") %></h3>
          <p class="mt-3 text-base text-gray-600"><%= t("home.solo_guides_section.benefits.content_control.text") %></p>
        </div>
      </div>

      <%# Benefit 6: Promo Page %>
      <div class="overflow-hidden bg-gray-50 rounded-lg shadow">
        <div class="p-6">
          <h3 class="text-xl font-semibold text-gray-900"><%= t("home.solo_guides_section.benefits.promo_page.title") %></h3>
          <p class="mt-3 text-base text-gray-600"><%= t("home.solo_guides_section.benefits.promo_page.text") %></p>
        </div>
      </div>
    </div>
  </div>
</section>

<%= render Home::FormComponent.new(guides: @guides, total_users: @total_users) %>
