<%# Renders links list for a single collection - expects local variable :collection %>
<div class="bg-white ring-1 ring-zinc-950/10 rounded-lg overflow-hidden">
  <div class="px-4 py-4 sm:px-6 bg-gray-50 border-b border-gray-200">
    <h4 class="text-md font-semibold text-gray-900"><%= collection.title %></h4>
    <p class="mt-1 text-xs text-gray-500">
      <%= t("guides.show.collection.places_count", count: collection.places_count) %>
    </p>
  </div>

  <% if collection.collection_links.any? %>
    <ul class="divide-y divide-gray-200">
      <% collection.collection_links.order(created_at: :desc).each do |link| %>
        <li id="<%= dom_id(link) %>" class="px-4 py-4 sm:px-6 flex flex-col space-y-4 hover:bg-gray-50 transition duration-150">
          <div class="flex items-center justify-between w-full">
            <div class="flex-1 min-w-0 pr-4">
              <p class="text-sm font-medium text-blue-600 break-all"><%= link.collection_link_url %></p>
              <p class="mt-1 text-xs text-gray-400">
                <%= l link.created_at, format: :short %> &nbsp;—&nbsp;
                <%= link.views_count %> <%= t("collection_links.link.views") %>
              </p>
            </div>

            <div class="flex flex-shrink-0 space-x-2">
              <%= render Shared::Buttons::BaseComponent.new(url: link.collection_link_url) do %>
                <%= t("collection_links.link.visit") %>
              <% end %>

              <div data-controller="qr-code"
                   data-action="click->qr-code#generate"
                   data-qr-code-url-value="<%= link.collection_link_url %>"
                   data-qr-code-id-value="<%= link.id %>"
                   class="inline-flex items-center">
                <%= render Shared::Buttons::PrimaryComponent.new(url: "#") do %>
                  <%= render Shared::IconComponent.new("share", color: "white") %>
                  <span class="ml-1"><%= t("collection_links.link.share") %></span>
                <% end %>
              </div>
            </div>
          </div>

          <div id="qr-code-<%= link.id %>-container" class="qr-code-container hidden w-full">
            <%= tag.turbo_frame id: "qr-code-#{link.id}", class: "block w-full" do %>
              <div class="flex justify-center items-center py-6 px-4 bg-gray-50 ring-1 ring-zinc-950/10 w-full">
                <%= render Shared::IconComponent.new("loader-2", color: "blue-500") %>
                <span class="text-sm text-gray-500"><%= t("collection_links.link.generating_qr") %></span>
              </div>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="px-4 py-5 sm:px-6">
      <p class="text-sm text-gray-500"><%= t("collection_links.empty_state.description") %></p>
    </div>
  <% end %>
</div>
