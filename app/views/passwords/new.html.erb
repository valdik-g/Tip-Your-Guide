<div class="mx-auto max-w-screen-xl -mt-15">
  <section class="relative h-screen" aria-labelledby="hero-heading">
    <div class="relative z-10 flex flex-col items-center justify-center h-full px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
      <h1 id="hero-heading" class="text-4xl font-bold tracking-tight text-center text-gray-900 sm:text-5xl md:text-6xl">
        <span class="block"><%= t("views.passwords.new.title") %></span>
      </h1>

      <%= form_with url: passwords_path, class: "mt-8 sm:max-w-md mx-auto w-full space-y-4 rounded-lg p-6 shadow-lg bg-white/90" do |form| %>
        <div>
          <label for="email" class="sr-only"><%= t("views.passwords.new.email_label") %></label>

          <div class="relative">
            <%= form.email_field :email,
                  required: true,
                  autofocus: true,
                  autocomplete: "email",
                  placeholder: t("views.passwords.new.email_placeholder"),
                  value: params[:email],
                  class: "w-full rounded-lg ring-gray-200 p-4 pe-12 text-sm shadow-xs" %>

            <span class="absolute inset-y-0 end-0 grid place-content-center px-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-4 text-gray-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
              </svg>
            </span>
          </div>
        </div>

        <%= form.submit t("views.passwords.new.submit"),
              class: "block w-full px-4 py-3 font-medium text-white rounded-md transition-colors duration-200 bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-600" %>

        <p class="text-center text-sm text-gray-500">
          <%= t("views.passwords.new.remember_password") %>
          <%= link_to t("views.passwords.new.sign_in"), new_session_path, class: "text-gray-500 underline hover:no-underline" %>
        </p>
      <% end %>
    </div>
  </section>
</div>
