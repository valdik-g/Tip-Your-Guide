<%= content_for :title, "#{t("views.shared.head.title")} - #{@guide.full_name}" %>
<%= content_for :og_title, "#{t("views.shared.head.title")} - #{@guide.full_name}" %>
<% if @guide.avatar.attached? %>
  <% variant = @guide.avatar.variant(resize_to_limit: [512, 512]).processed %>
  <%= content_for :og_image, url_for(variant) %>
<% end %>

<div class="max-w-7xl mx-auto px-2 sm:px-4 lg:px-8 py-2 sm:py-4">
  <%= render Guides::Profile::HeaderComponent.new(guide: @guide) %>

  <div class="flex justify-center gap-4 mb-10 lg:hidden">
    <%= link_to "#about-me", class: "px-4 py-2 bg-white shadow rounded-md text-grey-600 font-medium flex items-center justify-center" do %>
      <%= render Shared::IconComponent.new("user", color: "grey-600") %>
      <span class="ml-2"><%= t("guides.about_me_card.title") %></span>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[400px_minmax(0,1fr)] gap-6 w-full">
    <div class="order-1 lg:order-2 mb-6 lg:mb-0 min-w-0">
      <%# Collections Section %>
      <% if @guide.collections_enabled? %>
        <div class="overflow-hidden rounded-lg shadow-sm p-6">
          <div class="flex items-center mb-4">
            <div class="bg-blue-50 w-10 h-10 rounded-full inline-flex items-center justify-center text-xl">
              <%= render Shared::IconComponent.new("map-pinned", color: "blue-500") %>
            </div>
            <h2 class="text-lg font-bold tracking-tight text-gray-900 ml-2"><%= t(".collections") %></h2>
          </div>
          <%= render Guides::Profile::CollectionsComponent.new(collections: @collections, paid_links: @paid_links_per_collection) %>
        </div>
      <% end %>

    </div>

    <div class="w-full order-2 lg:order-1">
      <div id="about-me" class="mb-4">
        <%= render Guides::Profile::AboutMeComponent.new(guide: @guide) %>
      </div>
    </div>
  </div>
</div>
