<div class="container mx-auto px-4 py-8">
  <h1 class="text-4xl font-bold mb-8"><%= t("blog.title") %></h1>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    <% if @blog_posts.any? %>
      <% @blog_posts.each do |post| %>
        <%= link_to blog_post_path(post.locale, post.slug), class: "block bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300", hreflang: post.locale do %>
          <% if post.featured_image.present? %>
            <%= image_tag post.featured_image, class: "w-full h-48 object-cover" %>
          <% end %>

          <div class="p-6">
            <h2 class="text-xl font-semibold mb-2 text-gray-900 hover:text-blue-600">
              <%= post.title %>
            </h2>

            <p class="text-gray-600 mb-4">
              <%= post.meta_description %>
            </p>

            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-500">
                <%= post.published_at&.strftime(t("blog.date_format")) %>
              </span>
              <span class="text-sm text-gray-500">
                <%= post.author_name %>
              </span>
            </div>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <div class="col-span-full text-center py-8">
        <p class="text-gray-500"><%= t("blog.no_posts") %></p>
      </div>
    <% end %>
  </div>
</div>
