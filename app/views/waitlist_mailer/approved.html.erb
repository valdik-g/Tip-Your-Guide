<!-- Logo Section -->
<div style="text-align: center; margin-bottom: 40px;">
  <%= image_tag asset_path("logo.png"), alt: "Tip Your Guide", style: "max-width: 150px; height: auto;" %>
</div>

<!-- Main Content -->
<div class="content-box">
  <h1 style="color: #333333; font-size: 24px; margin-bottom: 20px; text-align: center;">
    <%= t("mailers.waitlist_mailer.approved.subject") %>
  </h1>

  <p style="color: #666666; font-size: 16px; line-height: 1.6; margin-bottom: 25px; text-align: center;">
    <%= t("mailers.waitlist_mailer.approved.body") %>
  </p>

  <!-- Button Container -->
  <div class="text-center">
    <a href="<%= edit_password_url(@token) %>" class="button" style="background-color: #4CAF50; color: #ffffff; text-decoration: none; display: inline-block;">
      <%= t("mailers.waitlist_mailer.approved.button") %>
    </a>
  </div>

  <div class="divider"></div>

  <!-- Welcome Message -->
  <p style="color: #888888; font-size: 14px; text-align: center; margin-bottom: 0;">
    <%= t("mailers.waitlist_mailer.welcome_message") %>
  </p>
</div>
