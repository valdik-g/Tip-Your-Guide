<%# app/views/shared/_place_card.html.erb %>

<%= link_to "place_path(place)", class: "block bg-white rounded-lg overflow-hidden shadow-md hover:shadow-xl transform hover:-translate-y-1 transition-all duration-300 min-w-[300px]" do %>
  <%# Place Image %>
  <div class="relative h-48 w-full overflow-hidden group">
    <% if false && place.photo.attached? %>
      <%= image_tag place.photo, class: "w-full h-full object-cover transition-transform duration-500 group-hover:scale-110", alt: place.title %>
    <% else %>
      <div class="w-full h-full bg-gray-200 flex items-center justify-center">
        <span class="text-gray-400">No image available</span>
      </div>
    <% end %>
  </div>

  <%# Content Section %>
  <div class="p-4 cursor-pointer hover:bg-blue-50 transition-colors duration-300">
    <%# Title and Rating %>
    <div class="flex justify-between items-start mb-2">
      <h3 class="font-bold text-lg text-gray-800 truncate group-hover:text-blue-600 transition-colors duration-300"><%= place.title %></h3>
      <div class="flex items-center">
        <div class="flex mr-1">
          <% 5.times do |i| %>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="<%= (i < place.rating) ? "currentColor" : "none" %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="<%= (i < place.rating) ? "text-yellow-400" : "text-gray-300" %>">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          <% end %>
        </div>
        <span class="text-sm font-medium"><%= sprintf("%.1f", place.rating) %></span>
      </div>
    </div>

    <%# Address %>
    <div class="flex items-center text-gray-600 mb-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      <p class="text-sm truncate"><%= place.address %></p>
    </div>

    <%# Price Range %>
    <div class="flex items-center mb-3">
      <% 4.times do |i| %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="<%= (i < place.price_range) ? "text-green-600" : "text-gray-300" %>">
          <line x1="12" y1="1" x2="12" y2="23"></line>
          <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
        </svg>
      <% end %>
    </div>

    <%# Description %>
    <% if place.description.present? %>
      <p class="text-gray-600 text-sm mb-3 line-clamp-2"><%= place.description %></p>
    <% end %>

  </div>
<% end %>
