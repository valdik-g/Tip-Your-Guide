<%= link_to external_url, target: "_blank", class: "block relative bg-white rounded-lg overflow-hidden shadow-md hover:shadow-xl transform hover:-translate-y-1 transition-all duration-300 min-w-[250px]", rel: "noopener" do %>
  <div class="relative h-40 w-full overflow-hidden group">
    <% if photo_url.present? %>
      <%= image_tag photo_url, class: "w-full h-full object-cover transition-transform duration-500 group-hover:scale-110", alt: place.title %>
    <% else %>
      <div class="w-full h-full bg-gray-200 flex items-center justify-center">
        <span class="text-gray-400">No image available</span>
      </div>
    <% end %>
  </div>

  <div class="p-3">
    <h3 class="font-bold text-gray-800 truncate"><%= place.title %></h3>
    <div class="flex justify-between mt-2 text-sm">
      <% if place.description.present? %>
        <div class="flex items-center mr-1">
          <div class="text-gray-600">
            <%= place.description.to_plain_text %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
