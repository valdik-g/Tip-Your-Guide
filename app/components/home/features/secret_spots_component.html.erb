<%# Secret spots %>
<div class="relative mb-2">
  <div class="lg:mx-auto lg:max-w-7xl lg:px-8 lg:grid lg:grid-cols-12 lg:gap-8 lg:items-center">
    <div class="relative lg:mt-0 lg:col-span-7" aria-hidden="true">
      <div class="relative mx-auto text-center lg:text-left">
        <div class="shadow-xl rounded-lg overflow-hidden">
          <img class="w-full h-96 object-cover" src="<%= secret_spots_image %>" alt="Secret local spots">
        </div>
      </div>
    </div>
    <div class="relative max-w-md mx-auto px-4 sm:max-w-3xl sm:px-6 lg:px-0 lg:col-span-5 mt-4">
      <div>
        <h3 class="text-2xl font-extrabold text-gray-900 tracking-tight sm:text-3xl">
          <%= t("home.features.secret_spots.title") %>
        </h3>
        <p class="mt-3 text-lg text-gray-500">
          <%= t("home.features.secret_spots.description") %>
        </p>
        <ul class="mt-6 space-y-3">
          <% t("home.features.secret_spots.benefits").each do |benefit| %>
            <li class="flex">
              <svg class="flex-shrink-0 h-5 w-5 text-green-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="ml-3 text-gray-500"><%= benefit %></span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
