<div class="relative w-full overflow-hidden bg-white pb-4">
  <% if session[:waitlist_email].blank? && !current_user %>
    <div class="w-full bg-gradient-to-r from-indigo-600 to-blue-600">
      <div class="mx-auto max-w-[2000px] px-4 py-1 sm:px-6 lg:px-8">
        <div class="flex h-10 items-center justify-center">
          <span class="text-sm font-medium text-white">
            <%= t("home.hero.commission_free_tipping_platform") %>
          </span>
          <a href="#waitlist_email"
             onclick="event.preventDefault(); document.getElementById('waitlist_email').scrollIntoView({behavior: 'smooth'});"
             class="ml-0 inline-flex items-center justify-center rounded-full bg-white px-3 py-1 text-xs font-semibold text-indigo-600 transition-colors duration-200 hover:scale-105 hover:bg-indigo-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-white z-10 md:ml-4">
            <%= t("home.hero.join_waitlist") %>
          </a>
        </div>
      </div>
    </div>
  <% end %>

  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute -top-40 -right-40 h-80 w-80 rounded-full bg-gradient-to-br from-indigo-200 to-indigo-400 opacity-30 blur-xl"></div>
    <div class="absolute top-40 -left-20 h-60 w-60 rounded-full bg-gradient-to-tr from-blue-300 to-blue-500 opacity-30 blur-xl"></div>
    <div class="absolute bottom-20 left-1/4 h-80 w-80 rounded-full bg-gradient-to-tr from-indigo-300 to-purple-400 opacity-15 blur-xl"></div>
    <div class="absolute -top-20 left-1/4 h-60 w-60 rounded-full bg-gradient-to-tr from-purple-300 to-pink-600 opacity-15 blur-xl"></div>
  </div>

  <header class="relative z-10 mt-4 bg-transparent">
    <div class="mx-auto max-w-[2000px] px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between lg:h-20">
        <div class="flex-shrink-0">
          <a href="<%= root_path %>" title="logo" class="flex">
            <img class="h-20 w-auto lg:h-24" src="<%= asset_path "favicon/favicon.svg" %>" alt="logo">
          </a>
        </div>

        <div class="ml-auto flex items-center">
          <div class="hidden lg:flex lg:items-center lg:space-x-6">
            <a href="#business" class="text-base font-medium text-gray-900 hover:text-indigo-600"
              onclick="event.preventDefault(); document.getElementById('business').scrollIntoView({behavior: 'smooth'});">
              <%= t("home.hero.for_business_link") %>
            </a>
            <a href="#solo-guides" class="text-base font-medium text-gray-900 hover:text-indigo-600"
              onclick="event.preventDefault(); document.getElementById('solo-guides').scrollIntoView({behavior: 'smooth'});">
              <%= t("home.hero.for_guides_link") %>
            </a>
            <a href="<%= icon_link_path %>"
            class="rounded-full p-2 text-gray-900 transition-colors duration-200 hover:bg-indigo-50 hover:text-indigo-600">
              <span class="sr-only"><%= t("home.hero.sign_in") %></span>
              <%= render Shared::IconComponent.new("user", color: "blue", size: 28) %>
            </a>
          </div>
        </div>
      </div>

      <div class="hidden lg:hidden" id="mobile-menu">
        <div class="space-y-1 px-2 pb-3 pt-2">
          <a href="#business"
             onclick="event.preventDefault(); document.getElementById('business').scrollIntoView({behavior: 'smooth'});"
             class="block rounded-md px-3 py-2 text-base font-medium text-gray-900 hover:bg-indigo-50 hover:text-indigo-600">
            <%= t("home.hero.for_business_link") %>
          </a>
          <a href="#solo-guides"
             onclick="event.preventDefault(); document.getElementById('solo-guides').scrollIntoView({behavior: 'smooth'});"
             class="block rounded-md px-3 py-2 text-base font-medium text-gray-900 hover:bg-indigo-50 hover:text-indigo-600">
            <%= t("home.hero.for_guides_link") %>
          </a>
          <a href="<%= new_session_path %>"
             class="block rounded-md px-3 py-2 text-base font-medium text-gray-900 hover:bg-indigo-50 hover:text-indigo-600">
            <%= t("home.hero.sign_in") %>
          </a>
        </div>
      </div>
    </div>
  </header>

  <section class="relative z-10 pb-16 pt-4 sm:pt-10 lg:pb-28 lg:pt-10">
    <div class="mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
        <div class="px-8">
          <div class="px-4 sm:px-8">
            <div class="mb-4 inline-flex items-center rounded-full bg-indigo-100 px-4 py-2 sm:mb-6">
              <p class="text-sm font-medium text-blue-600"><%= t("home.hero.beta_badge") %></p>
            </div>

            <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl md:text-6xl lg:text-5xl xl:text-7xl">
              <span id="rotating" class="block"><%= t("home.hero.title_words").first %></span>
              <span class="mt-1 block bg-gradient-to-r from-blue-600 to-pink-600 bg-clip-text text-transparent"><%= t("home.hero.subtitle") %></span>
            </h1>

            <p class="mt-4 max-w-3xl text-sm text-gray-500 sm:mt-6">
              <%= description %>
            </p>
          </div>
        </div>

        <div class="relative">
          <div class="relative z-10 w-[140%] overflow-hidden rounded-2xl shadow-xl md:h-[600px] md:right-[10%] lg:h-[700px] lg:right-[15%] xl:h-[800px] xl:right-[20%] transform rotate-1 sm:rotate-0">
            <img class="h-full w-full object-cover" src="<%= header_image_url %>" alt="Local guide showing travelers a hidden spot">
          </div>

          <%= users_count_badge %>
          <%= places_count_badge %>
          <%= payments_count_badge %>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Mobile menu toggle
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener('click', function() {
        mobileMenu.classList.toggle('hidden');
      });
    }

    // Existing rotating words functionality
    const words = <%= raw t("home.hero.title_words").to_json %>;
    let currentIndex = 0;
    const rotatingElement = document.getElementById("rotating");

    function rotateWords() {
      rotatingElement.style.opacity = 0;

      setTimeout(() => {
        currentIndex = (currentIndex + 1) % words.length;
        rotatingElement.textContent = words[currentIndex];
        rotatingElement.style.opacity = 1;
      }, 500);
    }

    // Set initial opacity to full
    rotatingElement.style.opacity = 1;
    rotatingElement.style.transition = 'opacity 0.5s ease-in-out';

    // Change word every 3 seconds
    setInterval(rotateWords, 3000);
  });
</script>
